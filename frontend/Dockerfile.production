FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build
FROM alpine:3.23
# Use the signed distribution package, not the separately packaged nginx.org build.
RUN apk upgrade --no-cache \
 && apk add --no-cache 'nginx>=1.28.3-r8' \
 && mkdir -p /run/nginx /etc/nginx/conf.d /usr/share/nginx/html
COPY nginx-main.conf /etc/nginx/nginx.conf
COPY nginx.production.conf /etc/nginx/conf.d/default.conf
COPY nginx-site.conf /etc/nginx/sirago-site.conf
COPY nginx-allowed-hosts.sh /usr/local/bin/sirago-gateway-init
RUN sed -i 's/\r$//' /usr/local/bin/sirago-gateway-init \
 && sh -n /usr/local/bin/sirago-gateway-init \
 && chmod 0755 /usr/local/bin/sirago-gateway-init
COPY --from=build /app/dist /usr/share/nginx/html
RUN DJANGO_ALLOWED_HOSTS=build.example.com /usr/local/bin/sirago-gateway-init \
 && rm -f /etc/nginx/sirago-vhosts.conf /etc/nginx/sirago-health-host
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/sirago-gateway-init"]
CMD ["nginx", "-g", "daemon off;"]
