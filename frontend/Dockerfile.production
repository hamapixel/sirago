FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build
FROM nginx:1.28-alpine
COPY nginx.production.conf /etc/nginx/conf.d/default.conf
COPY nginx-site.conf /etc/nginx/sirago-site.conf
COPY nginx-allowed-hosts.sh /docker-entrypoint.d/25-sirago-allowed-hosts.sh
RUN sed -i 's/\r$//' /docker-entrypoint.d/25-sirago-allowed-hosts.sh \
 && sh -n /docker-entrypoint.d/25-sirago-allowed-hosts.sh \
 && chmod 0755 /docker-entrypoint.d/25-sirago-allowed-hosts.sh
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
