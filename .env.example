POSTGRES_DB=sirago
POSTGRES_USER=sirago
POSTGRES_PASSWORD=local_dev_only_change_me
DJANGO_SECRET_KEY=local-dev-only-not-for-production-please-change
DJANGO_DEBUG=1

# SasPay: sandbox uniquement pour ce jalon. Ne jamais versionner la clé réelle.
SASPAY_API_KEY=

# Local only: keep off in production.
SIRAGO_ENABLE_SIMULATED_PAYMENTS=0

# Optional local-only hosted Checkout integration
SIRAGO_ENABLE_SASPAY_SANDBOX=0

# Local sandbox ticket issuance only; never LIVE
SIRAGO_ENABLE_SASPAY_TICKETS=0
SIRAGO_SASPAY_LOCAL_RETURN=0
SASPAY_SANDBOX_WEBHOOK_SECRET=
