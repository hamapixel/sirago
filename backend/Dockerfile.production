FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt .
RUN python -m pip install --no-cache-dir --upgrade pip==26.3 \
 && python -m pip install --no-cache-dir -r requirements.txt \
 && groupadd --system sirago && useradd --system --gid sirago --home-dir /app sirago
COPY --chown=sirago:sirago . .
RUN mkdir -p /app/staticfiles && chown sirago:sirago /app/staticfiles
USER sirago
EXPOSE 8000
CMD ["gunicorn","config.wsgi:application","--bind","0.0.0.0:8000","--workers","2","--threads","2","--timeout","60","--max-requests","1000","--max-requests-jitter","100","--access-logfile","-","--error-logfile","-"]
